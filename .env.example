HOST=127.0.0.1
PORT=8080
DRIVER=~fastapi
LOG_LEVEL=INFO
COMMAND_START=["/"]

CATTY_OPENAI_BASE_URL=https://api.openai.com/v1
CATTY_OPENAI_API_KEY=
CATTY_OPENAI_MODEL=gpt-4o-mini
CATTY_OPENAI_EXTRA_HEADERS=
CATTY_OPENAI_EXTRA_BODY=

CATTY_SYSTEM_PROMPT=你是一个接入 QQ 的中文 AI 助手，回答要友好、简洁、可靠。
CATTY_TRIGGER_PREFIXES=ai,AI,猫猫
CATTY_ENABLE_PRIVATE=true
CATTY_ENABLE_GROUP=true
CATTY_PRIVATE_REQUIRE_PREFIX=false
CATTY_GROUP_REQUIRE_MENTION_OR_PREFIX=true
CATTY_GROUP_HISTORY_SCOPE=group
CATTY_HISTORY_TURNS=8

CATTY_TEMPERATURE=0.7
CATTY_MAX_TOKENS=1000
CATTY_REQUEST_TIMEOUT=60
CATTY_REPLY_MAX_CHARS=1800

CATTY_ALLOWED_USER_IDS=
CATTY_ALLOWED_GROUP_IDS=
CATTY_HTTP_PROXY=
